{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stellarhunts.org/stellar-extensions/nft-ownership-puzzle-template.schema.json",
  "title": "StellarHunts NFT and Digital Ownership Puzzle",
  "type": "object",
  "required": ["id", "title", "description", "difficulty", "match_tier", "type", "content", "solution", "testCases"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "id": { "pattern": "^[a-zA-Z0-9_-]+$", "type": "string", "minLength": 1, "maxLength": 128 },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "minLength": 1 },
    "difficulty": { "enum": ["easy", "medium", "hard", "master"], "type": "string" },
    "match_tier": { "enum": ["beginner", "intermediate", "advanced", "expert"], "type": "string" },
    "type": { "enum": ["text", "number", "math", "multiple_choice", "logic", "code", "image"], "type": "string" },
    "content": {
      "type": "object",
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "initialCode": { "type": "string" },
        "language": { "enum": ["rust", "javascript", "python", "stellar-cli", "bash"], "type": "string" }
      },
      "additionalProperties": false
    },
    "solution": { "type": "string", "minLength": 1 },
    "solutionType": { "enum": ["plain", "sha256", "regex", "numeric_exact"], "type": "string", "default": "plain" },
    "hint": { "type": "string", "maxLength": 2048 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "isActive": { "type": "boolean", "default": true },
    "testCases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["title", "input", "expectedOutput"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "validationMode": { "enum": ["exact_match", "numeric_tolerance", "regex", "custom"], "type": "string" },
          "input": { "type": "object" },
          "expectedOutput": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "type": { "const": "multiple_choice" } } },
    "then": { "properties": { "content": { "required": ["prompt", "options"] } } }
  }],
  "additionalProperties": false
}
